{
  "name": "orca",
  "version": "0.1.0",
  "description": "Leave it to Orca — every idea, made real.",
  "private": true,
  "bin": {
    "orca": "bin/orca"
  },
  "workspaces": [
    "web"
  ],
  "type": "module",
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "test": "node scripts/test-affected.mjs",
    "gen:cli-docs": "tsx scripts/gen-cli-docs.ts",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "ledger": "tsx src/cli.ts",
    "verify": "node scripts/check-release-gate.mjs && npm run typecheck && npm run build && node scripts/check-gate-env.mjs && node scripts/verify-suite.mjs && (npm run ledger -- decision validate .decisions || [ $? -eq 2 ]) && node scripts/check-claude-md-lines.mjs && node scripts/check-hooks-path.mjs && npm run build --workspace web && npm run verify:ccloop-pin && npm run verify:panel && npm run --ws check",
    "verify:control": "node scripts/verify-control.mjs",
    "verify:web-control": "vitest run tests/control/web*.test.ts tests/panel/control*.test.ts",
    "verify:web-control:consumer": "vitest run tests/control/webCcloopSmoke.test.ts",
    "verify:scheduler": "node scripts/verify-scheduler.mjs",
    "verify:chain": "node scripts/verify-chain.mjs",
    "verify:panel": "tsx scripts/verify-panel.ts",
    "verify:ccloop-pin": "node scripts/verify-ccloop-pin.mjs",
    "hooks:install": "git config core.hooksPath scripts/githooks",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath scripts/githooks || true",
    "verify:saved-result": "node scripts/verify-saved-result.mjs"
  },
  "dependencies": {
    "@ast-grep/cli": "0.45.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ccloop": "github:blrbiran/ccloop#d02b9d2c6dbb4675a6f84fa7e9a7229883f7701a",
    "express": "^5.1.0",
    "yaml": "2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vite": "^6.4.4",
    "vitest": "^5.0.3"
  }
}
