+    expect(texts(container, "thead th")).toEqual(["安装", "类型", "版本", "默认模型", "默认上下文"]);
+    expect(texts(container, "tbody td")).toEqual(["codex", "codex", "1.0", "gpt-x", "agent 默认"]);
