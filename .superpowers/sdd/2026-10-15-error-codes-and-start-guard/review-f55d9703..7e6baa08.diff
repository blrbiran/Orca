+      peerFailureLogLine("run-1", new ControlError("control-peer-timeout"))])
+      .toEqual(["orca-driver: run-1: ccloop agent-config-invalid: bad\n", "orca-driver: run-1: ccloop unknown: Error: x\n", null]);
