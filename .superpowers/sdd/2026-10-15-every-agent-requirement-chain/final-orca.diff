+import type { Me } from "../src/auth.js";
+import type { AgentModelsViewV1, AgentPreferencesViewV1, AgentsViewV1, ControlConfigV1, ControlSummaryV1, RecoveryViewV1 } from "../src/controlTypes.js";
+
+const capability = { usageObservation: "phase-end", budgetEnforcement: "soft", contextObservation: "unavailable", handoffControl: "durable", handoffExecution: "mechanical-in-run-v1", contextWindowTokens: null, requestBoundProof: null } as const;
+const config: ControlConfigV1 = {
+  schema: "orca-control-config-v1", epoch: "epoch-a", repositories: [{ repoId: "orca", displayName: "Orca" }], plans: [],
+  profiles: [{ profileId: "all", profileHash: "b".repeat(64), allowedWorkKinds: ["task", "budget-estimate", "handoff", "goal-review"], contextTokenizer: null, workMaxOutputTokens: 1000, declared: capability, observed: capability, observedAt: "2026-09-26T00:00:00.000Z", probeFailureCode: null }],
+  defaults: { estimatorProfileId: "all", estimatorProfileHash: "b".repeat(64), estimateMode: "soft" }, executionPort: "configured", errorCatalog: [],
+};
+const summary: ControlSummaryV1 = { schema: "orca-control-summary-v1", epoch: "epoch-a", changeSeq: 0, resetRequired: false, dispatchBlocked: false, groups: [] };
+const recovery: RecoveryViewV1 = { schema: "orca-control-recovery-v1", epoch: "epoch-a", dispatchBlocked: false, blockers: [] };
+const agents: AgentsViewV1 = {
+  schema: "orca-agents-view-v1",
+  installations: [{ id: "codex", kind: "codex", defaults: { model: "gpt-6-sol", contextWindow: "agent-default" }, contextOptions: ["agent-default"], version: "0.155.1" }],
+};
+const preferences: AgentPreferencesViewV1 = { schema: "orca-agent-preferences-v1", operatorId: "operator-1", revision: 1, preferences: { defaultAgent: "codex", perAgent: {} } };
+const owner: Me = { user: { id: "u1", name: "olga", roles: ["owner"], mustChangePassword: false }, expiresAt: 0, sessionDays: 15 };
+const modelsView = (...names: string[]): AgentModelsViewV1 => ({
+  schema: "orca-agent-models-v1", installation: "codex", kind: "codex", source: "probe", observedAt: "2026-10-16T00:00:00.000Z",
+  models: names.map((model) => ({ model, contextWindowTokens: 272000, maxOutputTokens: null, singleCallExecution: "v1-soft" })),
+});
+const REPORT = { as_of: "2026-09-26T00:00:00.000Z", as_of_mode: "wall_clock", repos: [], correction_rate: { numerator_corrections_excluding_stale: 0, denominator_decisions: 0, rate_excluding_stale: null, corrections_total_including_stale: 0, by_decision_kind: [], buckets: [], caveats: [] }, repair_rate: { numerator_overturned: 0, denominator_corrections_including_stale: 0, rate: null, stale_only: { numerator_overturned: 0, denominator_corrections: 0, rate: null, known_bias: "" }, buckets: [], caveats: [] }, backlog: { open_corrections: 0, oldest_age_ms: null, oldest_correction_id: null, by_correction_kind: [] }, breakdown_by_correction_kind_including_stale: [], review_coverage: { available: false, reason: "none" }, unresolved_decisions: [], unkeyable_repos: [], malformed_lines: [] };
+const json = (body: unknown, status = 200): Response => new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json" } });
+
+/** Each models request, in the order the page sent it, held until the test answers it. */
+let modelReads: Array<{ url: string; answer: (view: AgentModelsViewV1) => void }>;
+let agentsReads: number;
+
+beforeEach(() => {
+  modelReads = [];
+  agentsReads = 0;
+  Object.defineProperty(document, "visibilityState", { configurable: true, get: () => "visible" });
+  globalThis.fetch = (async (input: RequestInfo | URL): Promise<Response> => {
+    const url = String(input);
+    if (url === "/api/todo") return json({ rows: [] });
+    if (url === "/api/projects") return json({ projects: [{ projectKey: "orca", controlRepoId: "orca" }] });
+    if (url === "/api/metrics") return json({ report: REPORT, panel_review_coverage: { reviewed_high_tier: 0, high_tier_total: 0, rate: 0, caveat: "" } });
+    if (url === "/api/chains") return json({ repos: [] });
+    if (url === "/api/control/config") return json(config);
+    if (url.startsWith("/api/control/summary")) return json(summary);
+    if (url === "/api/control/recovery") return json(recovery);
+    if (url === "/api/control/repositories/orca/workspace") return json({ schema: "orca-repository-workspace-v1", repoId: "orca", workspaceMode: "worktree", revision: 0 });
+    if (url === "/api/control/agents") { agentsReads += 1; return json(agents); }
+    if (url === "/api/control/operator/agent-preferences") return json(preferences);
+    if (url.startsWith("/api/control/agents/codex/models")) {
+      return new Promise<Response>((resolve) => { modelReads.push({ url, answer: (view) => resolve(json(view)) }); });
+    }
+    return json({ error: { code: "not-found", message: url } }, 404);
+  }) as typeof fetch;
+});
+
+afterEach(() => { cleanup(); window.sessionStorage.clear(); });
+
+/** The model names the codex default's datalist offers now; null when no list is on screen. */
+const listed = (): string[] | null => {
+  const list = document.getElementById("agents:per:codex:models");
+  return list === null ? null : [...list.querySelectorAll("option")].map((option) => option.value);
+};
+/** Real time for released answers (and the renders they cause) to reach the page. */
+const settle = (): Promise<void> => new Promise((resolve) => setTimeout(resolve, 100));
+
+describe("App's model-list reads (spec 2026-10-15 §5, Task 14 fix round 1)", () => {
+  it("keeps the newest read's list when an older read answers after it", async () => {
+    render(<AccountContext.Provider value={owner}><App /></AccountContext.Provider>);
+    await waitFor(() => expect(modelReads).toHaveLength(1));
+    // An owner's Refresh forces a read although the first is still in flight. (Every codex fieldset on the page -- the
+    // default and the role slots that inherit it -- offers the button; they all refresh the same installation.)
+    fireEvent.click((await screen.findAllByRole("button", { name: "Refresh models" }))[0]!);
+    await waitFor(() => expect(modelReads.map((read) => read.url)).toEqual(["/api/control/agents/codex/models", "/api/control/agents/codex/models?refresh=1"]));
+    modelReads[1]!.answer(modelsView("gpt-6-new"));
+    await waitFor(() => expect(listed()).toEqual(["gpt-6-new"]));
+    modelReads[0]!.answer(modelsView("gpt-6-old"));
+    await settle();
+    expect(listed()).toEqual(["gpt-6-new"]);
+  });
+
+  it("starts one background read per installation for two returns in a row", async () => {
+    render(<App />);
+    await waitFor(() => expect(modelReads).toHaveLength(1));
+    modelReads[0]!.answer(modelsView("gpt-6-sol"));
+    await waitFor(() => expect(listed()).toEqual(["gpt-6-sol"]));
+    const before = agentsReads;
+    fireEvent.focus(window);
+    fireEvent.focus(window);
+    await waitFor(() => expect(agentsReads).toBe(before + 2));
+    await settle();
+    expect(modelReads).toHaveLength(2);
+  });
+
+  it("keeps a read list on screen while a background re-read is pending", async () => {
+    render(<App />);
+    await waitFor(() => expect(modelReads).toHaveLength(1));
+    modelReads[0]!.answer(modelsView("gpt-6-sol"));
+    await waitFor(() => expect(listed()).toEqual(["gpt-6-sol"]));
+    fireEvent.focus(window);
+    await waitFor(() => expect(modelReads).toHaveLength(2));
+    await settle();
+    expect(listed()).toEqual(["gpt-6-sol"]);
+    expect(screen.queryByText("Reading the model list…")).toBe(null);
+    modelReads[1]!.answer(modelsView("gpt-6-sol", "gpt-6-luna"));
+    await waitFor(() => expect(listed()).toEqual(["gpt-6-sol", "gpt-6-luna"]));
+  });
+});
diff --git a/web/tests/agentModelsDatalist.test.tsx b/web/tests/agentModelsDatalist.test.tsx
new file mode 100644
index 00000000..8eb14fba
--- /dev/null
+++ b/web/tests/agentModelsDatalist.test.tsx
@@ -0,0 +1,92 @@
+// @vitest-environment jsdom
+/**
+ * Spec 2026-10-15 §5 (part C, R3): the selection editor offers an omp or codex installation's models as a datalist
+ * under a box that stays free text -- a model the list does not hold can still be typed -- and an unreadable list
+ * shows ccloop's reason, in words, beside that box. Claude keeps free text with no list. An owner may refresh the list
+ * (the panel passes onRefreshModels only to an owner); without it there is no button. RF5: an installation removed
+ * from the table while the editor is open answers agent-installation-missing, shown the same way.
+ */
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { SelectionFields } from "../src/AgentFields.js";
+import type { AgentsViewV1, ModelListState } from "../src/controlTypes.js";
+import i18n from "../src/i18n.js";
+
+afterEach(async () => { cleanup(); await i18n.changeLanguage("en"); });
+
+const agents: AgentsViewV1 = {
+  schema: "orca-agents-view-v1",
+  installations: [
+    { id: "claude", kind: "claude", defaults: { model: "claude-opus-5-5", contextWindow: "agent-default" }, contextOptions: ["agent-default", 1_000_000], version: "2.1.282" },
+    { id: "codex", kind: "codex", defaults: { model: "gpt-6-sol", contextWindow: "agent-default" }, contextOptions: ["agent-default"], version: "0.155.1" },
+    { id: "omp", kind: "omp", defaults: { model: "gateway/model-a", contextWindow: "agent-default" }, contextOptions: ["agent-default"], version: "18.10.1" },
+  ],
+};
+const PREFIX = "agents:per:x";
+const codexReady: ModelListState = { state: "ready", view: { schema: "orca-agent-models-v1", installation: "codex", kind: "codex", source: "probe", observedAt: "2026-10-16T00:00:00.000Z", models: [
+  { model: "gpt-6-luna", contextWindowTokens: null, maxOutputTokens: null, singleCallExecution: "v1-soft" },
+  { model: "gpt-6-sol", contextWindowTokens: 272000, maxOutputTokens: null, singleCallExecution: "v1-soft" },
+] } };
+
+const modelBox = (): HTMLInputElement => document.querySelector(`input[name="${PREFIX}:model"]`) as HTMLInputElement;
+
+describe("the model box offers omp and codex models (spec 2026-10-15 §5)", () => {
+  it("lists a codex installation's models with their windows and keeps the box free text", () => {
+    const onDraft = vi.fn();
+    const models = vi.fn((id: string) => (id === "codex" ? codexReady : undefined));
+    render(<SelectionFields agents={agents} prefix={PREFIX} label="slot" current={undefined} inheritedAgent="codex" fixedAgent="codex" drafts={{}} onDraft={onDraft} models={models} />);
+    expect(models).toHaveBeenCalledWith("codex");
+    const listId = modelBox().getAttribute("list");
+    expect(listId).not.toBe(null);
+    const list = document.getElementById(listId!);
+    expect(list?.tagName).toBe("DATALIST");
+    const options = [...list!.querySelectorAll("option")];
+    expect(options.map((option) => option.value)).toEqual(["gpt-6-luna", "gpt-6-sol"]);
+    expect(options[1]!.getAttribute("label")).toContain("272000");
+    fireEvent.change(modelBox(), { target: { value: "my-custom-model" } });
+    expect(onDraft).toHaveBeenCalledWith(`${PREFIX}:model`, "my-custom-model");
+  });
+
+  it("keeps claude's box free text with no list, even when a list is offered", () => {
+    const models = vi.fn(() => codexReady);
+    render(<SelectionFields agents={agents} prefix={PREFIX} label="slot" current={undefined} inheritedAgent="claude" fixedAgent="claude" drafts={{}} onDraft={vi.fn()} models={models} onRefreshModels={vi.fn()} />);
+    expect(modelBox().hasAttribute("list")).toBe(false);
+    expect(document.querySelector("datalist")).toBe(null);
+    expect(screen.queryByRole("button", { name: "Refresh models" })).toBe(null);
+  });
+
+  it("shows ccloop's reason in words beside a box that still takes text (and RF5's missing installation)", () => {
+    const detail = "timeout 30000ms · stage timeout · elapsedMs 30001";
+    const onDraft = vi.fn();
+    render(<SelectionFields agents={agents} prefix={PREFIX} label="slot" current={undefined} inheritedAgent="omp" fixedAgent="omp" drafts={{}} onDraft={onDraft}
+      models={() => ({ state: "unavailable", code: "omp-model-catalog-unavailable", detail })} />);
+    expect(screen.getByRole("note").textContent).toBe(`The model list is unavailable: omp could not list its model catalog (${detail}). Check that omp is installed and starts, then retry.`);
+    expect(modelBox().hasAttribute("list")).toBe(false);
+    fireEvent.change(modelBox(), { target: { value: "gateway/model-z" } });
+    expect(onDraft).toHaveBeenCalledWith(`${PREFIX}:model`, "gateway/model-z");
+    cleanup();
+    const onDraftGone = vi.fn();
+    render(<SelectionFields agents={agents} prefix={PREFIX} label="slot" current={undefined} inheritedAgent="codex" fixedAgent="codex" drafts={{}} onDraft={onDraftGone}
+      models={() => ({ state: "unavailable", code: "agent-installation-missing", detail: "" })} />);
+    expect(screen.getByRole("note").textContent).toBe("The model list is unavailable: The agents table has no installation of this agent.");
+    fireEvent.change(modelBox(), { target: { value: "gpt-6-terra" } });
+    expect(onDraftGone).toHaveBeenCalledWith(`${PREFIX}:model`, "gpt-6-terra");
+  });
+
+  it("offers Refresh models only when the panel passes onRefreshModels, and asks for the shown installation", () => {
+    const onRefreshModels = vi.fn();
+    render(<SelectionFields agents={agents} prefix={PREFIX} label="slot" current={undefined} inheritedAgent="codex" fixedAgent="codex" drafts={{}} onDraft={vi.fn()} models={() => codexReady} onRefreshModels={onRefreshModels} />);
+    fireEvent.click(screen.getByRole("button", { name: "Refresh models" }));
+    expect(onRefreshModels).toHaveBeenCalledWith("codex");
+    cleanup();
+    render(<SelectionFields agents={agents} prefix={PREFIX} label="slot" current={undefined} inheritedAgent="codex" fixedAgent="codex" drafts={{}} onDraft={vi.fn()} models={() => codexReady} />);
+    expect(modelBox().getAttribute("list")).not.toBe(null);
+    expect(screen.queryByRole("button", { name: "Refresh models" })).toBe(null);
+  });
+
+  it("names the refresh button in Chinese", async () => {
+    await i18n.changeLanguage("zh");
+    render(<SelectionFields agents={agents} prefix={PREFIX} label="slot" current={undefined} inheritedAgent="codex" fixedAgent="codex" drafts={{}} onDraft={vi.fn()} models={() => codexReady} onRefreshModels={vi.fn()} />);
+    expect(screen.getByRole("button", { name: "刷新模型列表" })).not.toBe(null);
+  });
+});
diff --git a/web/tests/runOutputBound.test.tsx b/web/tests/runOutputBound.test.tsx
