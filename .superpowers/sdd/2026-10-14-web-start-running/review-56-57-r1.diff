     expect(within(problemRow()).queryByRole("button", { name: "Verify saved results" })).toBeNull();
     cleanup();
     show(v, "progress");
     await new Promise((resolve) => setTimeout(resolve, 0));
     expect(within(workRow()).queryByRole("button", { name: "Verify saved results" })).toBeNull();
